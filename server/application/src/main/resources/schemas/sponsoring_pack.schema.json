      "type": [
        "integer",
        "null"
      ]
    },
    "required_options": {
      "type": "array",
      "items": {
        "$ref": "sponsoring_option.schema.json"
      }
    },
    "optional_options": {
      "type": "array",
      "items": {
        "$ref": "sponsoring_option.schema.json"
      }
